<!doctype html>
<html lang="sv">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AquaFlow – Vattenflaskor</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial,sans-serif;background:#f4fbff;color:#123}
header{padding:22px 7%;display:flex;justify-content:space-between;align-items:center;background:white;position:sticky;top:0;box-shadow:0 2px 12px #0001}
.logo{font-size:25px;font-weight:800;color:#168bd1}.cart{background:#168bd1;color:white;border:0;padding:11px 16px;border-radius:22px;font-weight:bold}
.hero{text-align:center;padding:65px 20px;background:linear-gradient(135deg,#dff5ff,#fff)}
.hero h1{font-size:45px;margin:10px}.hero p{font-size:18px;color:#567}
.shop{max-width:1000px;margin:35px auto;padding:0 20px}.card{background:white;border-radius:22px;padding:22px;box-shadow:0 5px 25px #00000012;max-width:330px;margin:auto;text-align:center}
.bottle{height:230px;border-radius:28px;background:linear-gradient(160deg,#73d7ff,#168bd1);width:105px;margin:5px auto 25px;position:relative;box-shadow:inset -12px 0 18px #0002}
.bottle:before{content:"";position:absolute;width:62px;height:35px;background:#168bd1;left:21px;top:-25px;border-radius:10px 10px 4px 4px}
.bottle:after{content:"AquaFlow";position:absolute;color:white;font-weight:bold;left:12px;top:105px;transform:rotate(-90deg)}
.price{font-size:25px;font-weight:bold}.buy{width:100%;padding:14px;border:0;border-radius:12px;background:#168bd1;color:#fff;font-size:16px;font-weight:bold;cursor:pointer}
footer{text-align:center;padding:40px;color:#789}
</style>
</head>
<body>
<header><div class="logo">💧 AquaFlow</div><button class="cart" onclick="alert('Varukorgen är tom – lägg till en flaska först!')">🛒 Varukorg (<span id="count">0</span>)</button></header>
<section class="hero"><h1>Drick smart. 💧</h1><p>Snygga och praktiska vattenflaskor för varje dag.</p></section>
<main class="shop">
<div class="card">
<div class="bottle"></div>
<h2>AquaFlow Bottle</h2>
<p>En enkel och stilren vattenflaska.</p>
<p class="price">59 kr</p>
<button class="buy" onclick="add()">Lägg i varukorg</button>
</div>
</main>
<footer>© 2026 AquaFlow · Frakt och betalning ordnas vid köp.</footer>
<script>
let n=0;
function add(){n++;document.getElementById('count').textContent=n;alert('Flaskan lades i varukorgen!')}
</script>
</body>
</html>
